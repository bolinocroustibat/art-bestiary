{
	"name": "art-bestiary",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test scripts src",
		"data:download": "mkdir -p data/raw && curl -L --fail -C - -o data/raw/joconde.csv https://ministere-culture.s3.sbg.io.cloud.ovh.net/POP/joconde.csv",
		"data:parse": "bun run scripts/parse-bestiary.ts && bun run scripts/parse-subjects.ts && bun run scripts/parse-nudes.ts",
		"icons:build": "bun run scripts/build-icons.ts"
	},
	"dependencies": {
		"@fontsource/bowlby-one": "^5.3.0",
		"@fontsource/courier-prime": "^5.3.0",
		"d3-scale": "^4.0.3",
		"d3-shape": "^3.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/bun": "^1.4.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "5.9.3",
		"vite": "^8.3.6"
	}
}
